# Copy this file to ".env" (same folder) and fill in the values. Never upload ".env" to GitHub.
# Without SMTP settings FinMate prints emails in the terminal instead of sending them.

# Address used inside email links (change it when the app goes online)
FINMATE_BASE_URL=http://127.0.0.1:5000

# Gmail example: turn on 2-Step Verification, then create an "App password" for Mail
FINMATE_SMTP_HOST=smtp.gmail.com
FINMATE_SMTP_PORT=587
FINMATE_SMTP_SECURITY=starttls
FINMATE_SMTP_USER=yourname@gmail.com
FINMATE_SMTP_PASSWORD=your-16-letter-app-password
FINMATE_MAIL_FROM=FinMate <yourname@gmail.com>

# Optional: a fixed secret key (16+ characters). If you leave this out a random one is saved in secret.key
#FINMATE_SECRET=****15IP

# Google Sign-In (OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=612365660267-b3s2i2e5fd1guqashcibs8ulrm4p6417.apps.googleusercontent.com

# Google Gemini API key for Pocket CA AI assistant (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
